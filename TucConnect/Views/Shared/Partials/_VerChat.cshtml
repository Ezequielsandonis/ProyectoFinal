


@using TucConnect.Models.Models.ViewModels
@model ChatViewModel

<div class="chat-container">
    <div class="chat-view">
        <div id="chat-messages">
            @Html.Partial("~/Views/Shared/Partials/_MessagesPartial.cshtml", Model.Messages)
        </div>
        <form id="send-message-form" method="post" asp-action="SendMessage" asp-controller="Chat">
            <input type="hidden" id="ChannelUrl" name="ChannelUrl" value="@Model.ChannelUrl" />
            <textarea id="Message" name="Message" required></textarea>
            <button type="submit">Enviar</button>
        </form>
    </div>
</div>





<style>
    .chat-container {
        display: flex;
        flex-direction: column;
        height: 100%;
        border: 1px solid #ccc;
        border-radius: 5px;
        overflow: hidden;
    }

    .chat-view {
        background-color: #f5f5f5; /* Fondo más suave para la vista del chat */
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    #chat-messages {
        flex: 1;
        padding: 20px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
    }

    .message {
        margin-bottom: 10px;
        padding: 10px;
        border-radius: 10px;
        max-width: 70%;
        word-wrap: break-word; /* Permite romper palabras largas */
        color:black;
    }

        .message.current-user {
            background-color: #d0e6ff; /* Azul claro para el mensaje del usuario autenticado */
            align-self: flex-end; /* Alinea los mensajes del usuario autenticado a la derecha */
            text-align: right;
        }

        .message.other-user {
            background-color: #ffffff; /* Blanco para los mensajes de otros usuarios */
            align-self: flex-start; /* Alinea los mensajes de otros usuarios a la izquierda */
            text-align: left;
        }

    .message-content {
        padding: 5px;
         font-size: 19px; /* Ajusta el tamaño de la letra aquí */
    }

        .message-content strong {
            font-weight: bold;
            color: #333; /* Color del nombre del usuario */
        }

    .timestamp {
        font-size: 0.8em;
        color: #888;
        display: block;
        margin-top: 5px;
    }

    .no-messages {
        text-align: center;
        margin-top: 20px;
        color: #888;
    }

    #send-message-form {
        display: flex;
        padding: 10px;
        border-top: 1px solid #ccc;
        background-color: #f9f9f9;
    }

        #send-message-form textarea {
            flex: 1;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            resize: none;
            margin-right: 10px;
            font-family: Arial, sans-serif;
            font-size: 14px;
        }

        #send-message-form button {
            padding: 10px 20px;
            border: none;
            background-color: #4CAF50;
            color: white;
            cursor: pointer;
            border-radius: 5px;
            font-size: 14px;
        }

</style>
