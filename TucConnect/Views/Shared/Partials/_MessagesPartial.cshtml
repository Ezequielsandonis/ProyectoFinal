@using TucConnect.Models.Models
@model IEnumerable<SendbirdMensaje>

@{
    var authenticatedUserId = ViewData["AuthenticatedUserId"]?.ToString() ?? string.Empty;
}

@if (Model != null && Model.Any())
{
    foreach (var message in Model)
    {
        // Determina si el mensaje es del usuario autenticado
        var isCurrentUserMessage = message.User != null && message.User.UserId == authenticatedUserId;

        <div class="message @(isCurrentUserMessage ? "current-user" : "other-user")">
            <div class="message-content">
                @if (!string.IsNullOrWhiteSpace(message.User?.Nickname))
                {
                  @message.Message
                }
                else
                {
                    <strong>@message.Message</strong>
                }
            </div>
            <span class="timestamp">@FormatTimestamp(message.CreatedAt)</span>
        </div>
    }
}
else
{
    <div class="no-messages">
        No tienes mensajes en este chat.
    </div>
}

@functions {
    public string FormatTimestamp(long timestamp)
    {
        if (timestamp <= 0)
        {
            return string.Empty;
        }

        var epoch = new DateTime(1970, 1, 1, 0, 0, 0, DateTimeKind.Utc);
        var utcDate = epoch.AddMilliseconds(timestamp);
        var argentinaTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Argentina Standard Time");
        var localDate = TimeZoneInfo.ConvertTimeFromUtc(utcDate, argentinaTimeZone);

        return localDate.ToString("HH:mm tt");
    }
}
